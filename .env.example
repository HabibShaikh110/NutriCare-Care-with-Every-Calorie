# Get a free key at https://aistudio.google.com → "Get API key"
# Never commit the real key. Local: .env.local · Render: Environment tab
GEMINI_API_KEY=your_key_here

# Optional: model override (default gemini-3.8-flash)
# If you hit free-tier rate limits, switch to gemini-3.5-flash-lite (500 req/day)
GEMINI_MODEL=gemini-3.8-flash

# Optional: auto-fallback when the primary model is overloaded (default shown)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
